---
import Icon from './Icon.astro';
import type { SocialEntry } from '../data/schema';
interface Props { entry: Extract<SocialEntry, { kind: 'link' }>; }
const { entry } = Astro.props;
---
<a class="card lift" href={entry.href} target="_blank" rel="noopener noreferrer" data-platform={entry.id}>
  <span class="tile"><Icon name={entry.icon} size={20} /></span>
  <span class="text">
    <span class="t-label">{entry.platform}</span>
    <span class="t-meta">{entry.display}</span>
  </span>
  <span class="go"><Icon name="arrow-up-right" size={16} /></span>
  <span class="visually-hidden">(opens in new tab)</span>
</a>

<style>
  .card {
    display: flex; align-items: center; gap: var(--space-3);
    min-height: 64px; padding: var(--space-4);
    background: var(--surface); border-radius: var(--radius-md); box-shadow: var(--elev-1);
    transition: transform var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
  }
  .tile {
    display: grid; place-items: center; flex: none; width: 40px; height: 40px;
    background: var(--accent-subtle); color: var(--accent); border-radius: var(--radius-sm);
    transition: background var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
  }
  .text { display: grid; min-width: 0; flex: 1; }
  .text .t-meta { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .go { color: var(--text-muted); transition: transform var(--dur-fast) var(--ease-standard), color var(--dur-fast); }
  .card:hover, .card:focus-visible { transform: translateY(-2px); box-shadow: var(--elev-2); }
  .card:hover .tile, .card:focus-visible .tile { background: var(--accent); color: var(--on-accent); }
  .card:hover .go, .card:focus-visible .go { transform: translate(2px, -2px); color: var(--accent); }
  .card:active { transform: scale(.985); transition-duration: var(--dur-instant); }
  @media (prefers-reduced-motion: reduce) {
    .card:hover, .card:focus-visible, .card:active { transform: none; }
    .card:hover .go, .card:focus-visible .go { transform: none; }
  }
</style>
