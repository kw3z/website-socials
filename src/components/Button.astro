---
import Icon from './Icon.astro';
interface Props { href: string; variant?: 'primary' | 'secondary' | 'ghost'; external?: boolean; icon?: string; }
const { href, variant = 'secondary', external = true, icon } = Astro.props;
---
<a class={`btn lift ${variant}`} href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
  <slot />
  {icon && <Icon name={icon} size={16} />}
  {external && <span class="visually-hidden">(opens in new tab)</span>}
</a>

<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    min-height: 44px; padding: 0 var(--space-4); border-radius: var(--radius-md);
    font: 500 .875rem/1.3 var(--font-ui); letter-spacing: .005em;
    transition: background var(--dur-fast) var(--ease-standard), color var(--dur-fast), transform var(--dur-instant);
  }
  .btn:active { transform: scale(.985); }
  .primary { background: var(--accent); color: var(--on-accent); }
  .primary:hover { background: var(--accent-hover); }
  .secondary { background: var(--surface); color: var(--text); border: 1px solid var(--border); }
  .secondary:hover { background: var(--accent-subtle); }
  .ghost { color: var(--accent); }
  .ghost:hover { background: var(--accent-subtle); }
  @media (prefers-reduced-motion: reduce) { .btn:active { transform: none; } }
</style>
