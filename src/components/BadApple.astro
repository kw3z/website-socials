---
import SectionHeading from './SectionHeading.astro';
---
<section class="bad-apple-section" aria-labelledby="bad-apple-heading" data-bad-apple>
  <SectionHeading id="bad-apple-heading" n="06" title="Bad Apple!!" />
  <div class="bad-apple glass">
    <div class="player-head">
      <div class="player-title"><span class="live-dot" aria-hidden="true"></span><div><h3>ASCII video player</h3><p>RULE 86: if it exists, you can play Bad Apple on it.</p></div></div>
      <div class="player-actions">
        <label class="volume-control"><span aria-hidden="true">♪</span><input type="range" min="0" max="1" step="0.05" value="0.5" aria-label="Bad Apple volume" /></label>
        <button class="toggle" type="button" aria-label="Play Bad Apple" disabled><span class="play-glyph">▶</span></button>
      </div>
    </div>
    <div class="screen" aria-live="off"><pre class="frame" aria-label="Bad Apple ASCII video">Loading video frames…</pre></div>
    <div class="player-foot">
      <span class="status" role="status">Loading the ASCII video…</span>
    </div>
    <audio class="audio" preload="metadata"></audio>
  </div>
  <p class="source-note">The ASCII frames are served from this site; the soundtrack streams from the public release.</p>
</section>

<style>
  .bad-apple-section { display:grid; gap:var(--space-5); }
  .bad-apple { padding:var(--space-4); border-radius:var(--radius-lg); overflow:hidden; }
  .player-head { display:flex; align-items:center; justify-content:space-between; gap:var(--space-4); padding:0 2px var(--space-4); }
  .player-title { display:flex; align-items:center; gap:var(--space-3); min-width:0; }
  .live-dot { width:9px; height:9px; flex:none; border-radius:50%; background:var(--accent); box-shadow:0 0 0 4px var(--accent-subtle); }
  .player-title h3 { font:600 1rem/1.3 var(--font-ui); }
  .player-title p { font:400 .75rem/1.4 var(--font-ui); color:var(--text-muted); }
  .player-actions { display:flex; align-items:center; gap:var(--space-3); }
  .volume-control { display:flex; align-items:center; gap:6px; color:var(--text-muted); }
  .volume-control input { width:76px; accent-color:var(--accent); cursor:pointer; }
  .toggle { width:38px; height:38px; display:grid; place-items:center; flex:none; border:1px solid var(--border); border-radius:50%; color:var(--text); background:var(--surface); transition:transform var(--dur-fast) var(--ease-out), background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast); }
  .toggle:not(:disabled) { cursor:pointer; }
  .toggle:not(:disabled):hover { transform:scale(1.07); color:var(--on-accent); background:var(--accent); border-color:var(--accent); }
  .toggle:not(:disabled):active { transform:scale(.92); transition-duration:70ms; }
  .toggle:disabled { opacity:.45; }
  .screen { width:fit-content; max-width:100%; min-height:0; max-height:none; display:grid; place-items:center; overflow:hidden; margin-inline:auto; padding:var(--space-4); border:1px solid var(--border); border-radius:var(--radius-md); background:#080a0d; color:#9ae6b4; box-shadow:inset 0 0 32px #0009; }
  .frame { margin:0; font:500 clamp(3px,.52vw,6px)/1.28 var(--font-mono); letter-spacing:0; white-space:pre; color:inherit; text-shadow:0 0 8px color-mix(in srgb, var(--accent) 22%, transparent); }
  .player-foot { display:flex; align-items:center; justify-content:space-between; gap:var(--space-3); padding:var(--space-3) 2px 0; color:var(--text-muted); font:400 .6875rem/1.3 var(--font-mono); }
  .status { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .source-note { color:var(--text-muted); font:400 .6875rem/1.45 var(--font-ui); }
  .bad-apple button:focus-visible,.bad-apple input:focus-visible { outline:2px solid var(--focus-ring); outline-offset:3px; }
  @media(max-width:500px) { .bad-apple { padding:var(--space-3); } .screen { padding:var(--space-2); } .player-head { gap:var(--space-2); } .volume-control input { width:54px; } }
  @media(prefers-reduced-motion:reduce) { .toggle { transition:none; } }
</style>

<script>
  import '../scripts/badapple';
</script>
