---
import { Image } from 'astro:assets';
import siteIcon from '../assets/images/site-icon.png';
import Icon from './Icon.astro';
---
<aside id="konami" class="note glass" role="status" aria-live="polite" hidden>
  <Image class="nap" src={siteIcon} alt="" width={112} height={112} loading="lazy" />
  <button class="close" type="button" id="konami-close" aria-label="Dismiss"><Icon name="x" size={16} /></button>
  <p class="line">Off the clock. You found the secret.</p>
  <p class="t-meta">↑↑↓↓←→←→BA</p>
</aside>

<style>
  .note {
    position: fixed; z-index: 70; inset-inline: var(--space-5); bottom: var(--space-5);
    margin-inline: auto; width: min(280px, calc(100% - 2.5rem));
    padding: calc(var(--space-6) + 36px) var(--space-5) var(--space-5); border-radius: var(--radius-lg);
    box-shadow: var(--glass-highlight), var(--elev-4);
    opacity: 0; transform: translateY(16px);
    transition: opacity var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out);
  }
  @media (min-width: 720px) { .note { inset-inline: auto var(--space-6); bottom: var(--space-6); margin: 0; } }
  .note[data-show='true'] { opacity: 1; transform: none; }
  .nap { position: absolute; top: -44px; left: 50%; width: 112px; height: 112px; margin-left: -56px; object-fit: contain; }
  .line { font: italic 500 1.0625rem/1.4 var(--font-display); }
  .close {
    position: absolute; top: var(--space-2); inset-inline-end: var(--space-2);
    width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--radius-sm); color: var(--text-muted);
  }
  .close:hover { color: var(--text); background: var(--accent-subtle); }
  .note[data-show='true'] .nap { animation: breathe 4s var(--ease-standard) 3; }
  @keyframes breathe { 50% { transform: scale(1.015); } }
  @media (prefers-reduced-motion: reduce) { .note { transform: none; transition-duration: var(--dur-instant); } .note[data-show='true'] .nap { animation: none; } }
</style>
